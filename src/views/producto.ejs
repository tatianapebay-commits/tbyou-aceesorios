<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="detalle">
    <img src="<%= producto.imagen_url || '/images/sin-imagen.svg' %>" alt="<%= producto.nombre %>"
         onerror="this.onerror=null;this.src='/images/sin-imagen.svg'">

    <div class="detalle-info">
        <a href="/productos?categoria=<%= producto.categoria_id %>" class="etiqueta"><%= producto.categoria %></a>
        <h1><%= producto.nombre %></h1>
        <p class="precio grande">$<%= producto.precio_venta.toLocaleString('es-AR') %></p>
        <% if (producto.descripcion) { %><p><%= producto.descripcion %></p><% } %>
        <p><strong>Material:</strong> <%= producto.material %></p>
        <% if (producto.stock > 0) { %>
            <p class="stock">Stock disponible: <%= producto.stock %></p>
            <a class="boton" target="_blank"
               href="https://wa.me/?text=<%= encodeURIComponent('Hola! Quiero comprar: ' + producto.nombre) %>">
                <i class="fab fa-whatsapp"></i> Consultar por WhatsApp
            </a>
        <% } else { %>
            <p class="stock sin-stock">Sin stock por el momento</p>
        <% } %>
        <p><a href="/productos">← Volver a productos</a></p>
    </div>
</section>

<%- include('partials/footer') %>
